{
  "name": "ai-teleprompter",
  "version": "2.0.0",
  "description": "Voice-tracking AI teleprompter for macOS",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite",
    "dev:react": "vite",
    "build": "tauri build",
    "build:frontend": "vite build",
    "build:win": "tauri build --target x86_64-pc-windows-msvc",
    "build:sidecar": "bash scripts/build-sidecar.sh",
    "snap:save": "node scripts/snap.mjs save",
    "snap:check": "node scripts/snap.mjs check",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^25.8.0",
    "vite": "^8.0.7",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@tiptap/extension-color": "^3.22.3",
    "@tiptap/extension-text-style": "^3.22.3",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zustand": "^5.0.12"
  }
}
